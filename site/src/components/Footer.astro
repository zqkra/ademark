---
import Logo from "./Logo.astro";
import { PASS } from "../data/results";
import { KOFI_URL } from "../data/links";
---
<footer class="footer">
  <div class="wrap inner">
    <div class="left">
      <Logo />
      <span class="small">First results, {PASS.published}. Code Apache-2.0, data CC BY 4.0</span>
    </div>
    {KOFI_URL && (
      <div class="right">
        <span>Donations pay for the test accounts and hosting.</span>
        <a class="btn btn--primary" href={KOFI_URL}>Donate</a>
      </div>
    )}
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    border-top: 1px solid var(--color-hairline);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-top: 40px;
    padding-bottom: 56px;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 20px;
    font: 400 16px/22px var(--font-sans);
  }
  @media (max-width: 720px) {
    .inner,
    .right {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
