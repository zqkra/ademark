---
// An app's mark in one ink, without background. The Bare CLI gets a prompt glyph.
import type { App } from "../data/results";

interface Props {
  app: App;
  size?: number;
}
const { app, size = 20 } = Astro.props;
---
{app.mark ? (
  <img class="mark" src={app.mark} alt="" width={size} height={size} loading="lazy" decoding="async" />
) : (
  <svg class="mark mark--cli" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true">
    <path d="M4 6l4 4-4 4M10 14h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
  </svg>
)}
