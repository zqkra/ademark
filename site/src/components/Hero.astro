---
import { REQUEST_ADE_URL } from "../data/links";
import { ADES, PASS } from "../data/results";
---
<section class="hero" data-hero>
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="wrap content">
    <h1>Every ADE, measured.</h1>
    <p class="lede">{ADES.length} ADEs, measured side by side. Pick yours.</p>
    <div class="actions">
      <a class="btn btn--primary" href="#results">
        See results
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M2 7l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <a class="btn" href={REQUEST_ADE_URL}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
        Request an ADE
      </a>
    </div>
    <p class="stamp small">First results, {PASS.published}</p>
  </div>
</section>

<script>
  import { mountOrb } from "../scripts/orb";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = hero?.querySelector<HTMLCanvasElement>("canvas");
  const title = hero?.querySelector<HTMLElement>("h1");
  if (hero && canvas && title) document.fonts.ready.then(() => mountOrb(canvas, hero, title));
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: clamp(620px, calc(100svh - 73px), 940px);
    display: flex;
    align-items: center;
  }
  .field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .content {
    position: relative;
    z-index: 1;
  }
  h1 {
    margin: 0;
    max-width: 860px;
    font-family: var(--font-dot);
    font-weight: 900;
    font-size: clamp(52px, 6.6vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .lede {
    margin: 32px 0 0;
    font: 400 24px/32px var(--font-sans);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .actions .btn {
    height: 48px;
  }
  .stamp {
    margin: 20px 0 0;
  }
  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      padding-bottom: 72px;
    }
    .field {
      opacity: 0.45;
    }
    .lede {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
