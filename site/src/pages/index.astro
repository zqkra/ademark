---
import "../styles/global.css";
import dotoFont from "@fontsource-variable/doto/files/doto-latin-wght-normal.woff2?url";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Results from "../components/Results.astro";
import Compare from "../components/Compare.astro";
import Report from "../components/Report.astro";
import Method from "../components/Method.astro";
import Fairness from "../components/Fairness.astro";
import Data from "../components/Data.astro";
import Footer from "../components/Footer.astro";
import { X_HANDLE } from "../data/links";
import { ADES } from "../data/results";

const url = "https://ademark.dev/";
const title = "ADEMark: every ADE, measured. The open ADE benchmark";
const description = `First results: ${ADES.length} ADEs on one Mac with the same agent and model, ranked on launch speed, memory, CPU, tokens and orchestration. Pick yours.`;
const image = `${url}og.png`;
const imageAlt = "ADEMark. Every ADE, measured. A halftone orb of dots with a pink rim.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${url}#website`,
      url,
      name: "ADEMark",
      description,
      inLanguage: "en",
      publisher: { "@id": `${url}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${url}#organization`,
      name: "ADEMark",
      url,
      logo: `${url}apple-touch-icon.png`,
      sameAs: [`https://x.com/${X_HANDLE}`],
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="preload" href={dotoFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="ADEMark" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${X_HANDLE}`} />
    <meta name="twitter:creator" content={`@${X_HANDLE}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <Results />
      <Compare />
      <Report />
      <Method />
      <Fairness />
      <Data />
    </main>
    <Footer />
  </body>
</html>
